<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ý��������Ȩ�� -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- ǰ̨����Ȩ�� -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ 媒体通知需要通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ���� Android 11+ �������ɼ��� -->
    <queries tools:node="merge" />

    <application
        android:name=".MusicApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_music_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.KeydroidX.Music">

        <!-- �����б������� -->
        <activity
            android:name="io.github.cctyl.keydroidx.music.ui.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            正在播放详情页：exported=true 供 Launcher 组件通过显式 Intent 启动。

            launchMode=singleTask 是修复「任务栈叠层」的关键：
            桌面组件用 ACTION_MAIN + FLAG_ACTIVITY_NEW_TASK 启动本页，而按挂机键/红键
            回桌面时本页只是被压到后台、并没有 finish()，再次从组件进入就会在本页之上
            再压一个新的 MusicPlayerActivity —— 进出 N 次就叠 N 层，需要连按 N 次返回
            才能回到 Tab 页。singleTask 保证：
              1) 本任务栈内永远只有一个播放页实例（复用走 onNewIntent）；
              2) 再次进入时自动清空它上方压着的页面（例如从播放页打开的播放列表页）；
              3) 无论外部（桌面组件/通知栏）用哪种 flag 启动都生效。
            注意：未显式声明 taskAffinity，沿用应用默认（包名），因此播放页仍然落在
            音乐应用自己的任务栈里，位于 MainActivity 之上，返回即可回到 Tab。
        -->
        <activity
            android:name="io.github.cctyl.keydroidx.music.ui.MusicPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask" />

        <!-- 歌单详情页 -->
        <activity
            android:name="io.github.cctyl.keydroidx.music.ui.PlaylistDetailActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- 歌曲评论页（从正在播放页数字键 3 / 评论按钮进入） -->
        <activity
            android:name="io.github.cctyl.keydroidx.music.ui.CommentActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- 本地音乐页 -->
        <activity
            android:name="io.github.cctyl.keydroidx.music.ui.LocalMusicActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- 下载管理页 -->
        <activity
            android:name="io.github.cctyl.keydroidx.music.ui.DownloadActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true" />

        <!-- 网易云 WebView 登录页 -->
        <activity
            android:name="io.github.cctyl.keydroidx.music.ui.WebLoginActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- 网易云 Cookie 设置页 -->
        <activity
            android:name="io.github.cctyl.keydroidx.music.ui.CookieSettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />



        <!-- 播放服务 -->
        <service
            android:name="io.github.cctyl.keydroidx.music.player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 播放状态 ContentProvider（供 Launcher 组件、系统 AppWidget 读取当前播放态） -->
        <provider
            android:name="io.github.cctyl.keydroidx.music.provider.PlaybackProvider"
            android:authorities="io.github.cctyl.keydroidx.music.playback"
            android:exported="true" />

        <!-- 音乐播放系统小组件 -->
        <receiver
            android:name="io.github.cctyl.keydroidx.music.widget.MusicAppWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_app_widget_info" />
        </receiver>
    </application>

</manifest>
