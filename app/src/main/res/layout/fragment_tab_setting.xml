<?xml version="1.0" encoding="utf-8"?>
<!--
    设置 Tab 内容页
    单列列表，支持上下键循环导航
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/ll_setting_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- ── 1. 登录 / 退出登录 ── -->
        <LinearLayout
            android:id="@+id/item_setting_auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/icon_setting_auth"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_setting_auth_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="登录网易云"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="@dimen/nokia_font_body"
                    
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_setting_auth_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按 OK 登录网易云音乐"
                    android:textColor="@color/music_subtext"
                    android:textSize="@dimen/nokia_font_caption"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 2. 网易云 Cookie 设置 ── -->
        <LinearLayout
            android:id="@+id/item_setting_cookie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/icon_setting_cookie"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_setting_cookie_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cookie_settings_title"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="@dimen/nokia_font_body"
                    
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_setting_cookie_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手动导入 / 查看 Cookie"
                    android:textColor="@color/music_subtext"
                    android:textSize="@dimen/nokia_font_caption"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 3. 意见反馈 ── -->
        <LinearLayout
            android:id="@+id/item_setting_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/icon_setting_feedback"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_setting_feedback_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="意见反馈"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="@dimen/nokia_font_body"
                    
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_setting_feedback_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="提交问题或使用建议"
                    android:textColor="@color/music_subtext"
                    android:textSize="@dimen/nokia_font_caption"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 4. 详细日志 ── -->
        <LinearLayout
            android:id="@+id/item_setting_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/icon_setting_log"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_setting_log_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="详细日志：关"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="@dimen/nokia_font_body"
                    
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_setting_log_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="仅记录 ERROR 错误与崩溃堆栈"
                    android:textColor="@color/music_subtext"
                    android:textSize="@dimen/nokia_font_caption"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 5. 关于 ── -->
        <LinearLayout
            android:id="@+id/item_setting_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/icon_setting_about"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_setting_about_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_about"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="@dimen/nokia_font_body"
                    
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_setting_about_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="版本信息与致谢"
                    android:textColor="@color/music_subtext"
                    android:textSize="@dimen/nokia_font_caption"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 6. 退出应用 ── -->
        <LinearLayout
            android:id="@+id/item_setting_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/icon_setting_exit"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_setting_exit_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="退出应用"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="@dimen/nokia_font_body"
                    
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_setting_exit_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="停止播放服务并退出程序"
                    android:textColor="@color/music_subtext"
                    android:textSize="@dimen/nokia_font_caption"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
