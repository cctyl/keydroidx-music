<?xml version="1.0" encoding="utf-8"?>
<!--
    单条评论
    结构：
      [头像(24dp，图标兜底/网络头像二选一)] [昵称 + 时间 / 正文(3行截断) / 点赞数]
    条目可聚焦：由 NokiaListFocusHelper 统一做循环导航与防出界滚动。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_comment_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- 头像：未加载出网络图时显示人形图标占位 -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="1dp">

        <TextView
            android:id="@+id/icon_comment_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@color/music_accent"
            android:includeFontPadding="false" />

        <ImageView
            android:id="@+id/iv_comment_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 右侧内容区 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="6dp"
        android:orientation="vertical">

        <!-- 昵称 + 时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_comment_nickname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/music_item_normal_text"
                android:textSize="@dimen/nokia_font_body"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_comment_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:textColor="@color/music_subtext"
                android:textSize="@dimen/nokia_font_caption"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 正文：列表内最多 3 行，全文按确定键在弹窗里看 -->
        <TextView
            android:id="@+id/tv_comment_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/music_subtext"
            android:textSize="@dimen/nokia_font_body"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:includeFontPadding="false" />

        <!-- 点赞数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/icon_comment_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="@color/music_subtext"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_comment_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:textColor="@color/music_subtext"
                android:textSize="@dimen/nokia_font_caption"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
