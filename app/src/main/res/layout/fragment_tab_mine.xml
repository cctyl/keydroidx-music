<?xml version="1.0" encoding="utf-8"?>
<!-- 我的 Tab 内容页 -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/music_dark_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 固定入口区（3 条）                                  -->
        <!-- ═══════════════════════════════════════════════════ -->

        <!-- ── 入口 1: 我喜欢的音乐 ── -->
        <LinearLayout
            android:id="@+id/item_favorites"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/icon_favorites"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_favorites"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_favorites_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/music_subtext"
                    android:textSize="10sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/badge_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:background="@drawable/bg_badge"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:background="@color/music_divider" />

        <!-- ── 入口 2: 最近播放历史 ── -->
        <LinearLayout
            android:id="@+id/item_history"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/icon_history"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_history"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_history_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/music_subtext"
                    android:textSize="10sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/badge_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:background="@drawable/bg_badge"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:background="@color/music_divider" />

        <!-- ── 入口 3: 本地音乐扫描 ── -->
        <LinearLayout
            android:id="@+id/item_local"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/icon_local"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_local"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_local_sub"
                    android:textColor="@color/music_subtext"
                    android:textSize="10sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="@string/mine_local_badge"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:background="@drawable/bg_badge"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Section Header: 自建与收藏歌单                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#4D000000">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/music_accent" />

            <TextView
                android:id="@+id/tv_section_playlist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:textColor="@color/music_section_header_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 歌单列表（代码动态填充）                             -->
        <!-- ═══════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/ll_playlist_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
