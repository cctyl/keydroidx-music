<?xml version="1.0" encoding="utf-8"?>
<!-- 我的 Tab 内容页 -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/music_dark_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 用户信息头部（登录后显示头像/昵称/等级/粉丝）       -->
        <!-- ═══════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layout_user_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="#33000000">

            <!-- 头像（网络图加载失败时显示人形图标） -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <TextView
                    android:id="@+id/icon_user_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:textColor="@color/music_subtext"
                    android:includeFontPadding="false" />

                <ImageView
                    android:id="@+id/iv_user_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />
            </FrameLayout>

            <!-- 昵称 + 副信息 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_user_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="9sp"
                    
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_user_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/music_subtext"
                    android:textSize="8sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- VIP 徽章（黑胶用户显示） -->
            <TextView
                android:id="@+id/badge_vip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="VIP"
                android:textColor="#8B5A2B"
                android:textSize="8sp"
                
                android:background="@drawable/bg_badge"
                android:visibility="gone"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 固定入口区（3 条）                                  -->
        <!-- ═══════════════════════════════════════════════════ -->

        <!-- ── 入口 1: 我喜欢的音乐 ── -->
        <LinearLayout
            android:id="@+id/item_favorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/icon_favorites"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_favorites"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="9sp"
                    
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_favorites_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/music_subtext"
                    android:textSize="8sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/badge_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:background="@drawable/bg_badge"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- ── 入口 2: 最近播放历史 ── -->
        <LinearLayout
            android:id="@+id/item_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/icon_history"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_history"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="9sp"
                    
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_history_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/music_subtext"
                    android:textSize="8sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/badge_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:background="@drawable/bg_badge"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- ── 入口 3: 下载管理 ── -->
        <LinearLayout
            android:id="@+id/item_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/icon_download"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_download"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="9sp"
                    
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_download_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_download_sub"
                    android:textColor="@color/music_subtext"
                    android:textSize="8sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/badge_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="@string/mine_download_badge"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:background="@drawable/bg_badge"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- ── 入口 4: 本地音乐扫描 ── -->
        <LinearLayout
            android:id="@+id/item_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/icon_local"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/music_accent"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_local"
                    android:textColor="@color/music_item_normal_text"
                    android:textSize="9sp"
                    
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_local_sub"
                    android:textColor="@color/music_subtext"
                    android:textSize="8sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="@string/mine_local_badge"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:background="@drawable/bg_badge"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Section Header: 自建与收藏歌单                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="26dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="#4D000000">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/music_accent" />

            <TextView
                android:id="@+id/tv_section_playlist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:textColor="@color/music_section_header_text"
                android:textSize="9sp"
                
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 歌单列表（代码动态填充）                             -->
        <!-- ═══════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/ll_playlist_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
