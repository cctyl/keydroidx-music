<!--
    关于页
      ScrollView
        应用图标
        应用名 + 版本号
        简介文字
        作者行
        开源地址行
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/music_dark_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 应用图标                                             -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ImageView
            android:id="@+id/iv_about_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_music_launcher" />

        <TextView
            android:id="@+id/tv_about_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/music_item_normal_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/tv_about_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/music_subtext"
            android:textSize="10sp"
            android:text="v1.0.0" />

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 简介                                                 -->
        <!-- ═══════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tv_about_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/music_subtext"
            android:textSize="11sp"
            android:text="@string/about_desc" />

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 作者                                                 -->
        <!-- ═══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/icon_about_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/music_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/music_subtext"
                android:textSize="11sp"
                android:text="@string/about_author_label" />

            <TextView
                android:id="@+id/tv_about_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/music_item_normal_text"
                android:textSize="11sp"
                android:text="@string/about_author" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 开源地址（可聚焦行，确认键打开浏览器）                -->
        <!-- ═══════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/ll_about_repo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_selectable_item">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/icon_about_repo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/music_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/music_subtext"
                    android:textSize="11sp"
                    android:text="@string/about_repo_label" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_about_repo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/music_accent"
                android:textSize="11sp"
                android:text="@string/about_repo_url" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
