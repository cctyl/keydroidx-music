<?xml version="1.0" encoding="utf-8"?>
<!--
    音乐主界面：纵向布局
    ┌─────────────────────┐
    │     Tab 栏 (4个)    │  ← 响应式高度（程序计算，约 11.76% 屏幕高）
    ├─────────────────────┤
    │      分割线          │  ← 2dp
    ├─────────────────────┤
    │   内容区（各 Tab）   │  ← 可滚动
    └─────────────────────┘
    顶部标题栏 / 底部软键由 NokiaBaseActivity 的骨架提供
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/music_dark_bg">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Tab 栏                                                  -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:background="@color/music_tab_bg">

        <!-- ── Tab 1: 我的 ── -->
        <!-- FrameLayout 使指示条可以通过 layout_gravity="bottom" 固定在底部 -->
        <FrameLayout
            android:id="@+id/tab_mine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tab_icon_mine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/tab_label_mine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_mine"
                    android:textSize="@dimen/nokia_font_small_title"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 激活指示条：固定在底部 -->
            <View
                android:id="@+id/tab_indicator_mine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_gravity="bottom"
                android:background="@color/music_accent"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- ── Tab 2: 发现 ── -->
        <FrameLayout
            android:id="@+id/tab_discover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tab_icon_discover"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/tab_label_discover"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_discover"
                    android:textSize="@dimen/nokia_font_small_title"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <View
                android:id="@+id/tab_indicator_discover"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_gravity="bottom"
                android:background="@color/music_accent"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- ── Tab 3: 榜单 ── -->
        <FrameLayout
            android:id="@+id/tab_chart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tab_icon_chart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/tab_label_chart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_chart"
                    android:textSize="@dimen/nokia_font_small_title"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <View
                android:id="@+id/tab_indicator_chart"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_gravity="bottom"
                android:background="@color/music_accent"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- ── Tab 4: 搜索 ── -->
        <FrameLayout
            android:id="@+id/tab_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tab_icon_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/tab_label_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_search"
                    android:textSize="@dimen/nokia_font_small_title"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <View
                android:id="@+id/tab_indicator_search"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_gravity="bottom"
                android:background="@color/music_accent"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- ── Tab 5: 设置 ── -->
        <FrameLayout
            android:id="@+id/tab_setting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tab_icon_setting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/tab_label_setting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_setting"
                    android:textSize="@dimen/nokia_font_small_title"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <View
                android:id="@+id/tab_indicator_setting"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_gravity="bottom"
                android:background="@color/music_accent"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>

    <!-- Tab 栏底部分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/music_tab_bottom_line" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- 内容区 - 5个 Tab 内容页面，GONE/VISIBLE 切换             -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab 1: 我的 -->
        <include
            android:id="@+id/content_mine"
            layout="@layout/fragment_tab_mine"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Tab 2: 发现 -->
        <include
            android:id="@+id/content_discover"
            layout="@layout/fragment_tab_discover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Tab 3: 榜单 -->
        <include
            android:id="@+id/content_chart"
            layout="@layout/fragment_tab_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Tab 4: 搜索 -->
        <include
            android:id="@+id/content_search"
            layout="@layout/fragment_tab_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Tab 5: 设置 -->
        <include
            android:id="@+id/content_setting"
            layout="@layout/fragment_tab_setting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>