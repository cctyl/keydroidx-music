<?xml version="1.0" encoding="utf-8"?>
<!--
    正在播放详情页 (Player) + 全屏歌词覆盖层
    根 FrameLayout（自下而上）：
      · 第 0 层 = 当前歌曲封面铺满整屏。代码里先把位图降到几十像素再交给 ImageView
                  双线性放大，观感即网易云那种「模糊封面底」，不需要 RenderScript。
      · 第 1 层 = 渐变压暗遮罩（bg_player_scrim），顶部轻、底部重，保证文字可读
      · 第 2 层 = 播放详情：歌名/歌手 → 大圆盘（居中）→ 进度条 → 按键指南 → 操作栏
      · 第 3 层 = 全屏歌词（默认隐藏，* 键弹出，盖住整块内容区）
    标题栏与软键栏由 KeydroidxBaseActivity 提供，覆盖层只盖内容区。

    本页已不再显示常驻歌词列表：视觉主体就是「背景封面 + 居中大圆盘（中心是封面）」，
    歌词只在 * 键唤起的全屏歌词层里出现。
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/music_dark_bg">

    <!-- ⓪ 背景：当前歌曲封面（模糊铺满）
         注意：不要写 android:filterBitmap——该属性在 XML 里不存在（只有 setFilterBitmap 方法），
         ImageView 默认就开启双线性过滤，正是放大低分辨率位图得到平滑模糊底所必需的。 -->
    <ImageView
        android:id="@+id/iv_player_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- ⓪ 背景遮罩：渐变压暗 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_scrim" />

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- 第一层：播放详情                                    -->
    <!-- ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_player_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- ① 歌曲标题 + 歌手（置于顶部，把整块中部让给圆盘，对齐网易云版式） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tv_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="@dimen/keydroidx_font_title"
                android:textColor="#FFFFFF"
                android:shadowColor="#B3000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textSize="@dimen/keydroidx_font_caption"
                android:textColor="#D9FFFFFF"
                android:shadowColor="#B3000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- ② 圆盘区：weight 占满剩余空间并居中；圆盘实际尺寸在代码里按可用空间自适应，
             以同时适配 240×320 与 320×480 两种按键机 -->
        <LinearLayout
            android:id="@+id/layout_upper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/vinyl_disk"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:background="@drawable/bg_vinyl_disk">

                    <!-- 唱盘中心：圆形专辑封面；无封面时露出红色中心盖 + ♪ 兜底图标 -->
                    <FrameLayout
                        android:id="@+id/vinyl_center"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_vinyl_center">

                        <ImageView
                            android:id="@+id/iv_vinyl_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/iv_play_pause"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textSize="20sp"
                            android:textColor="#FFFFFF"
                            android:includeFontPadding="false" />
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ③ 进度条 + 时间行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <FrameLayout
                android:id="@+id/progress_track"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:background="@drawable/bg_progress_bar">

                <View
                    android:id="@+id/progress_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_progress_fill" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_caption"
                    android:textColor="@color/music_subtext"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_play_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="@dimen/keydroidx_font_caption"
                    android:textColor="@color/music_subtext"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_caption"
                    android:textColor="@color/music_subtext"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ④ 按键指南条 -->
        <LinearLayout
            android:id="@+id/layout_key_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#88000000"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <LinearLayout
                android:id="@+id/guide_lyrics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_guide_lyrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_body"
                    android:textColor="#FDE047"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_caption"
                    android:textColor="#FDE047"
                    android:text="@string/guide_lyrics"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/guide_prev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_guide_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_body"
                    android:textColor="#CBD5E1"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_caption"
                    android:textColor="#94A3B8"
                    android:text="@string/guide_prev"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/guide_playpause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_guide_playpause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_body"
                    android:textColor="#CBD5E1"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_caption"
                    android:textColor="#94A3B8"
                    android:text="@string/guide_playpause"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/guide_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_guide_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_body"
                    android:textColor="#CBD5E1"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_caption"
                    android:textColor="#94A3B8"
                    android:text="@string/guide_next"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/guide_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_guide_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_body"
                    android:textColor="#FDE047"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_caption"
                    android:textColor="#FDE047"
                    android:text="@string/guide_mode"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ⑤ 歌曲操作栏（红心 / 下载 / 评论+数量）
             放在按键指南条正下方、紧贴底部软键栏，单行三等分。
             物理按键：数字键 1=红心 2=下载 3=评论；触屏点击走同一套 action 函数。
             注意：本行各单元格一律不设 focusable，避免抢走 layout_player_root 的焦点
             （播放页靠根视图持焦来防「首个方向键被触摸模式吞掉」）。
        -->
        <LinearLayout
            android:id="@+id/layout_song_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#88000000"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <!-- 数字键 1：收藏 / 取消收藏 -->
            <LinearLayout
                android:id="@+id/action_favorite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_action_favorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_body"
                    android:textColor="#FFFFFF"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_caption"
                    android:textColor="#FDE047"
                    android:text="@string/guide_favorite"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 数字键 2：下载 -->
            <LinearLayout
                android:id="@+id/action_download"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_action_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_body"
                    android:textColor="#FFFFFF"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_caption"
                    android:textColor="#FDE047"
                    android:text="@string/guide_download"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 数字键 3：进入评论区（图标右侧数字 = 评论总数，>999 显示 999+） -->
            <LinearLayout
                android:id="@+id/action_comment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/icon_action_comment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/keydroidx_font_body"
                        android:textColor="#FFFFFF"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tv_comment_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:textSize="@dimen/keydroidx_font_caption"
                        android:textColor="#FDE047"
                        android:singleLine="true"
                        android:maxLength="4"
                        android:visibility="gone"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/keydroidx_font_caption"
                    android:textColor="#FDE047"
                    android:text="@string/guide_comment"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- 第二层：全屏歌词覆盖层（默认隐藏）                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/layout_lyric_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/music_dark_bg"
        android:visibility="gone">

        <!-- 背景：与播放页同一张虚化封面。
             复用同一个 Bitmap 对象，两个 ImageView 共享，不额外占内存；
             无封面时保持透明，露出本层自己的主题深色底。 -->
        <ImageView
            android:id="@+id/iv_lyric_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- 压暗遮罩：歌词是密集小字，比播放页压得更重，保证任何封面上都读得清 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_lyric_fullscreen_scrim" />

        <ScrollView
            android:id="@+id/scroll_lyric_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <LinearLayout
                android:id="@+id/layout_lyric_full_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="120dp"
                android:paddingBottom="120dp"
                android:clipToPadding="false">

                <!-- 歌词行容器（动态填充） -->
                <LinearLayout
                    android:id="@+id/layout_lyric_full_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
