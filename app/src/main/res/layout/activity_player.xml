<?xml version="1.0" encoding="utf-8"?>
<!--
    正在播放详情页 (Player) + 全屏歌词覆盖层
    根 FrameLayout：
      · 第一层 = 播放详情（唱片/歌词/进度/按键指南）
      · 第二层 = 全屏歌词（默认隐藏，* 键弹出，盖住整块内容区）
    标题栏与软键栏由 NokiaBaseActivity 提供，覆盖层只盖内容区。
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/music_dark_bg">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- 第一层：播放详情                                    -->
    <!-- ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_player_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- ① 上部固定区（* 键可整体隐藏） -->
        <LinearLayout
            android:id="@+id/layout_upper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp">

                <FrameLayout
                    android:id="@+id/vinyl_disk"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:background="@drawable/bg_vinyl_disk">

                    <FrameLayout
                        android:id="@+id/vinyl_center"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_vinyl_center">

                        <TextView
                            android:id="@+id/iv_play_pause"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textSize="20sp"
                            android:textColor="#FFFFFF"
                            android:includeFontPadding="false" />
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_song_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="@dimen/nokia_font_body"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_song_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="@color/music_subtext"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ② 歌词列表区（weight=1 填充剩余空间） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/scroll_lyric"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:focusable="false"
                android:focusableInTouchMode="false">

                <LinearLayout
                    android:id="@+id/layout_lyric_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                </LinearLayout>
            </ScrollView>

        </FrameLayout>

        <!-- ③ 进度条 + 时间行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <FrameLayout
                android:id="@+id/progress_track"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:background="@drawable/bg_progress_bar">

                <View
                    android:id="@+id/progress_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_progress_fill" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="@color/music_subtext"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_play_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="@color/music_subtext"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="@color/music_subtext"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ④ 按键指南条 -->
        <LinearLayout
            android:id="@+id/layout_key_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#88000000"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <LinearLayout
                android:id="@+id/guide_lyrics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_guide_lyrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FDE047"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="#FDE047"
                    android:text="@string/guide_lyrics"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/guide_prev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_guide_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#CBD5E1"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="#94A3B8"
                    android:text="@string/guide_prev"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/guide_playpause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_guide_playpause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#CBD5E1"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="#94A3B8"
                    android:text="@string/guide_playpause"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/guide_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_guide_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#CBD5E1"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="#94A3B8"
                    android:text="@string/guide_next"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/guide_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_guide_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FDE047"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="#FDE047"
                    android:text="@string/guide_mode"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ⑤ 歌曲操作栏（红心 / 下载 / 评论+数量）
             放在按键指南条正下方、紧贴底部软键栏，单行三等分。
             物理按键：数字键 1=红心 2=下载 3=评论；触屏点击走同一套 action 函数。
             注意：本行各单元格一律不设 focusable，避免抢走 layout_player_root 的焦点
             （播放页靠根视图持焦来防「首个方向键被触摸模式吞掉」）。
        -->
        <LinearLayout
            android:id="@+id/layout_song_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#88000000"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <!-- 数字键 1：收藏 / 取消收藏 -->
            <LinearLayout
                android:id="@+id/action_favorite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_action_favorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="#FDE047"
                    android:text="@string/guide_favorite"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 数字键 2：下载 -->
            <LinearLayout
                android:id="@+id/action_download"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/icon_action_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="#FDE047"
                    android:text="@string/guide_download"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 数字键 3：进入评论区（图标右侧数字 = 评论总数，>999 显示 999+） -->
            <LinearLayout
                android:id="@+id/action_comment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/icon_action_comment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tv_comment_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:textSize="@dimen/nokia_font_caption"
                        android:textColor="#FDE047"
                        android:singleLine="true"
                        android:maxLength="4"
                        android:visibility="gone"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/nokia_font_caption"
                    android:textColor="#FDE047"
                    android:text="@string/guide_comment"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- 第二层：全屏歌词覆盖层（默认隐藏）                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/layout_lyric_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/music_dark_bg"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/scroll_lyric_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <LinearLayout
                android:id="@+id/layout_lyric_full_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="120dp"
                android:paddingBottom="120dp"
                android:clipToPadding="false">

                <!-- 歌词行容器（动态填充） -->
                <LinearLayout
                    android:id="@+id/layout_lyric_full_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
