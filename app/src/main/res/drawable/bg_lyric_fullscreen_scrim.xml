<?xml version="1.0" encoding="utf-8"?>
<!--
    全屏歌词层遮罩（叠在虚化封面之上）。

    与播放页的 bg_player_scrim 同源思路，但压得更重：歌词是整屏最密的小字，
    封面色再好看也不能影响认字，所以中部给到约 85% 黑，只留一点封面色调做氛围。
    （播放页文字少、圆盘为主视觉，所以那边只压到 55%~92%。）

    角度 270° = 自上而下。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#B3000000"
        android:centerColor="#D9000000"
        android:endColor="#F2000000" />
</shape>
