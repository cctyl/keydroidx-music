<?xml version="1.0" encoding="utf-8"?>
<!--
    歌词预览框：
    - 圆角矩形 + 主题主色（青色）半透明叠加
    - 边框使用同色实线（不用虚线，避免部分 ROM 渲染异常）
    - 与正在播放页背景对比清晰，整条呈高亮"选中"观感
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#4038BDF8"
        android:endColor="#6010B5D5" />
    <stroke
        android:width="1dp"
        android:color="#805FB7FF" />
    <corners android:radius="6dp" />
</shape>
